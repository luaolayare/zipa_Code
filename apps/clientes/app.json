{
  "expo": {
    "name": "Zipa lo tiene",
    "slug": "vitrina-local",
    "scheme": "vitrinalocal",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.zipa.vitrinalocal",
      "infoPlist": {
        "NSCameraUsageDescription": "Zipa lo tiene usa la cámara para mostrarte en realidad aumentada, sobre tu mesa o en tu espacio, el plato o producto que estás viendo. No tomamos ni guardamos fotos.",
        "NSLocationWhenInUseUsageDescription": "Zipa lo tiene usa tu ubicación mientras usas la app para mostrarte los negocios más cercanos y a qué distancia están. No la guardamos en tu perfil."
      }
    },
    "android": {
      "package": "co.zipa.vitrinalocal",
      "adaptiveIcon": {
        "backgroundColor": "#0F3D3E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
