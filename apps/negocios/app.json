{
  "expo": {
    "name": "LocalmenteTuyo Negocios",
    "slug": "vitrina-negocios",
    "scheme": [
      "localmentetuyonegocios",
      "vitrinanegocios"
    ],
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.localmentetuyo.negocios"
    },
    "android": {
      "package": "com.localmentetuyo.negocios",
      "adaptiveIcon": {
        "backgroundColor": "#FDF9F3",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "LocalmenteTuyo Negocios usa la cámara para que tomes la foto de tu local, que revisamos para verificar el negocio, y las fotos y los videos sin sonido de tus productos que verán tus clientes.",
          "photosPermission": "LocalmenteTuyo Negocios accede a tus fotos solo cuando eliges una foto de tu local o un video de un producto que ya tienes guardado.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "LocalmenteTuyo Negocios usa la cámara para que tomes la foto de tu local, que revisamos para verificar el negocio, y las fotos y los videos sin sonido de tus productos que verán tus clientes.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": false
        }
      ],
      "expo-status-bar",
      "expo-font",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0F3D3E",
          "defaultChannel": "reservas"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FDF9F3"
        }
      ],
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "LocalmenteTuyo Negocios usa tu ubicación solo cuando tú lo pides, para confirmar el punto de tu local en el mapa.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3c87b418-e945-4676-8581-0d11a27c77d2"
      }
    },
    "owner": "luisdev1796"
  }
}
