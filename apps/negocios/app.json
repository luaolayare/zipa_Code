{
  "expo": {
    "name": "Zipa lo tiene Negocios",
    "slug": "vitrina-negocios",
    "scheme": "vitrinanegocios",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.zipa.vitrinanegocios"
    },
    "android": {
      "package": "co.zipa.vitrinanegocios",
      "adaptiveIcon": {
        "backgroundColor": "#0F3D3E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Zipa lo tiene Negocios usa la cámara para que tomes la foto de tu local, que revisamos para verificar el negocio, y para grabar sin sonido el video de tus productos con el que creamos la vista 3D.",
          "photosPermission": "Zipa lo tiene Negocios accede a tus fotos solo cuando eliges una foto de tu local o un video de un producto que ya tienes guardado.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3c87b418-e945-4676-8581-0d11a27c77d2"
      }
    },
    "owner": "luisdev1796"
  }
}
