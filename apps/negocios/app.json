{
  "expo": {
    "name": "Zipa lo tiene Negocios",
    "slug": "vitrina-negocios",
    "scheme": "vitrinanegocios",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "co.zipa.vitrinanegocios"
    },
    "android": {
      "package": "co.zipa.vitrinanegocios",
      "adaptiveIcon": {
        "backgroundColor": "#0F3D3E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "3c87b418-e945-4676-8581-0d11a27c77d2"
      }
    },
    "owner": "luisdev1796"
  }
}
