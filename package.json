{
  "name": "zipa-code",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clientes": "npm run start --workspace=clientes",
    "negocios": "npm run start --workspace=negocios",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "negocios:tunel": "npm run start --workspace=negocios -- --tunnel",
    "clientes:tunel": "npm run start --workspace=clientes -- --tunnel"
  },
  "overrides": {
    "react": "19.3.0"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3"
  }
}
